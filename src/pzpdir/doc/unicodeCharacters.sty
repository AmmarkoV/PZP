% Loaded by doc/doxyfile (LATEX_EXTRA_STYLESHEET), as in SharedMemoryVideoBuffers: pdflatex stops
% with "Unicode character not set up" on characters it has no glyph for, so the symbols used in
% the comments are typeset as math symbols or their closest ASCII look-alikes.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{unicodeCharacters}
\DeclareUnicodeCharacter{2264}{\ensuremath{\leq}}     % ≤
\DeclareUnicodeCharacter{2265}{\ensuremath{\geq}}     % ≥
\DeclareUnicodeCharacter{00D7}{\ensuremath{\times}}   % ×
\DeclareUnicodeCharacter{2192}{\ensuremath{\rightarrow}} % →
\DeclareUnicodeCharacter{2190}{\ensuremath{\leftarrow}}  % ←
\DeclareUnicodeCharacter{2248}{\ensuremath{\approx}}  % ≈
\DeclareUnicodeCharacter{2500}{-}   % ─
\DeclareUnicodeCharacter{2502}{|}   % │
